# Dependencies
node_modules/
/.pnp
.pnp.js

# Next.js build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
*/.pytest_cache/
.ipynb_checkpoints/

# Machine Learning Artifacts & Pickles (general ignores)
*.pkl
*.joblib
*.h5
*.onnx

# Explicitly track backend production ML models and metadata
!backend/models/*.joblib
!backend/models/metadata.json
!backend/models/.gitkeep

# Environment Variables & Secrets
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local

# Preserve template files
!.env*.example
!.env.example
!frontend/.env*.example
!backend/.env*.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Editor & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
