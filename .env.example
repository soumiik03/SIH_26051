# =============================================================================
# SIH 26051: Cold-Climate Shelter Thermal Comfort Platform
# Unified Environment Variable Reference for Deployment
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (Configure in backend/.env or Cloud Service)
# -----------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Comma-separated list of allowed origins or * for all
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (Configure in frontend/.env.local or Vercel)
# -----------------------------------------------------------------------------
# URL where your FastAPI backend is running (e.g., https://your-backend.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public domain of your frontend (e.g., https://your-frontend.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
