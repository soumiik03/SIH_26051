# -----------------------------------------------------------------------------
# Cold-Climate Shelter Thermal Comfort API - Backend Environment Template
# Copy this file to .env before starting the server.
# -----------------------------------------------------------------------------

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# CORS Allowed Origins
# Comma-separated list of allowed frontend URLs (or * to allow all origins).
# For production, specify your deployed frontend URL (e.g. https://your-frontend.vercel.app)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
