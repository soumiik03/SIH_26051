# -----------------------------------------------------------------------------
# Cold-Climate Shelter Thermal Comfort - Frontend Environment Template
# Copy this file to .env.local for local development, or set these environment
# variables in your deployment dashboard (e.g. Vercel, Netlify).
# -----------------------------------------------------------------------------

# Backend FastAPI base URL
# In production, change to your deployed backend URL (e.g. https://shelter-backend.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application Public URL (used for sharing designs and QR code links)
# In production, set to your live website URL (e.g. https://shelter-design.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
